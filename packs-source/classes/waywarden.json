            "keyAbilityText": "Strength or Dexterity",
            "terms": [
                [
                    "The Mark",
                    "You designate a creature as your quarry, gaining a growing bonus to track, target, and punish it specifically. Refreshed once per encounter or scene."
                ],
                [
                    "Feral Bond",
                    "Your tamed mutant beast companion, chosen at 1st level. Grows through four stages: Whelp, Bonded, Alpha, Apex-Touched."
                ],
                [
                    "Wasteland Edge",
                    "Your combat style, chosen at 1st level. Functions as your subclass."
                ],
                [
                    "Feral Surge",
                    "Pushing your bond with your Feral Bond past its normal limits for a burst of combined ferocity. Yours from 6th: once per day, one more at 9th, 13th, and 17th. Risks Frenzy."
                ],
                [
                    "Frenzy",
                    "What happens when a Feral Surge goes wrong — the bond slips and the beast (or you) stops taking direction. Roll on the Frenzy Table (§4)."
                ]
