    "flags": {
        "cinderfall": {
            "tagline": "Somebody is still transmitting. Nobody has ever found the tower.",
            "role": "Banked-reroll support",
            "pillar": "Culture — what got kept",
            "hpFormula": "8 + Con / level",
            "keyAbilityText": "Charisma",
            "spellcastingText": "Occult, spontaneous (Cha)",
            "spellcastingTradition": "Occult",
            "spellcastingPreparation": "spontaneous",
            "terms": [
                [
                    "Broadcast",
                    "<strong>Your stance — 1 action, free to sustain.</strong> While it's up you are transmitting, everyone within 60 feet who can hear you is <em>in range</em>, and you build Encore. Ends if you Dismiss it, fall unconscious, or are deafened."
                ],
                [
                    "Encore",
                    "<strong>Your class resource, and your party's.</strong> Builds 1 at the start of each of your turns while Broadcast is up. Cap 3/5/7/9 at levels 1/7/13/19; overflow is lost, and the pool empties when Broadcast ends."
                ],
                [
                    "In range",
                    "<strong>Within 60 feet of you and able to hear you.</strong> Both allies and enemies — every Broadcast effect that helps also has a version that lands on whoever else is listening."
                ],
                [
                    "Spending Encore",
                    "<strong>Once per round, an ally who fails a check may spend 1 Encore from your pool to reroll it</strong> and keep the new result. It costs them no action of any kind. It is your resource, spent by them, at the moment they need it."
                ],
                [
                    "Crescendo",
                    "<strong>Blowing the whole bank</strong> (§3). 1 action, needs 5+ Encore. Converts your entire pool into one Standing Reroll for every ally in range, good for a minute."
                ],
                [
                    "Standing Reroll",
                    "<strong>A banked second chance sitting in an ally's pocket.</strong> One use, expires after a minute, costs no action and no Encore to cash in."
                ],
                [
                    "Frequency",
                    "<strong>Your subclass</strong> — Numbers, Open Band, or Requiem (§2). Chosen at 1st level. What you are actually transmitting, and what that does to the people who hear it."
                ],
                [
                    "Transmission",
                    "<strong>What this class calls its cantrips</strong> — Sign On, Sign Off, Test Tone and the rest. Auditory, occult, and useless against anything that can't hear."
                ]
            ],
