        "cinderfall": {
            "tagline": "You didn't build a machine. You gave something dead a reason to get up again.",
            "role": "Engineer / Gadgeteer",
            "pillar": "Cybernetics · Soul-Static",
            "hpFormula": "8 + Con / level",
            "keyAbilityText": "Intelligence",
            "terms": [
                [
                    "Ghost-Static",
                    "Residual soul-charge bled off dead machines, executed raging spirits, and pre-Turning reactors. Your fuel. Tracked as a pool of charges in your Static Cell."
                ],
                [
                    "Static Cell",
                    "Where your Ghost-Static sits. Holds 3 charges; one more at 5th, 9th, 13th, and 17th, to a ceiling of 7."
                ],
                [
                    "Redline",
                    "Pushing your Rig past safe tolerances for a burst of power. Applies to one system at a time unless an effect says otherwise — Full Burn, once per encounter, is the whole-Rig exception. Two uses per day; one more at 5th, 9th, 13th, and 17th. Can trigger Slippage."
                ],
                [
                    "Slippage",
                    "What happens when Redline goes wrong. Roll on the Slippage Table (§4)."
                ],
                [
                    "Rig",
                    "Your Innovation — the one machine you built better than anything else in your life. Chosen at 1st level."
                ],
                [
                    "Pattern",
                    "Your working philosophy as an engineer. Functions as your subclass, chosen at 1st level."
                ]
            ],
