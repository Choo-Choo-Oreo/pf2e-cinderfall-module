        "cinderfall": {
            "tagline": "The Choir burns the dead so they don't get up. You're the one exception they don't advertise — the rite that actually lets one go.",
            "role": "Sacrament-Keeper / Passage-Cantor",
            "pillar": "Faith — the Choir of Ash's second sacrament",
            "hpFormula": "10 + Con / level",
            "keyAbilityText": "Strength or Dexterity",
            "terms": [
                [
                    "Embers",
                    "Your Ikons, reskinned — objects that have carried a passing: a censer, a ring taken off someone you ferried, a coal that never fully cools. You carry two, and can raise a third and fourth as you level."
                ],
                [
                    "Ash-Light",
                    "Your Transcendence, reskinned — the shift as it moves between your Embers. Visible as a faint, warm glow under the skin near whichever Ember is active; anyone who's seen a Choir crematory recognizes it immediately."
                ],
                [
                    "A Passing",
                    "The act of ferrying a soul all the way through. Requires an incapacitated or willing spirit/undead target, an available Ember, and enough Passage headroom to survive the cost — see §3."
                ],
                [
                    "Passage",
                    "Your signature resource — a one-way track, like Drift or Resonance elsewhere in this setting. It only goes up. Every soul you ferry adds to it, permanently, for the rest of your career."
                ],
                [
                    "Walking Through",
                    "What happens at the top of the Passage track. Not a death — a graduation. See §3."
                ]
            ],
