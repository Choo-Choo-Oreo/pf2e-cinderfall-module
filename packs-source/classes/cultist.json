        "cinderfall": {
            "tagline": "You didn't find religion. Something found you first, and it's been very patient about collecting.",
            "role": "Patron-Bound Spellcaster",
            "pillar": "Faith / Pact Magic",
            "hpFormula": "6 + Con / level",
            "keyAbilityText": "Intelligence",
            "spellcastingTradition": "occult",
            "terms": [
                [
                    "The Bargain",
                    "Your pact with a specific petty god, chosen at 1st level. Replaces \"Patron.\""
                ],
                [
                    "The Idol",
                    "The small vessel your patron speaks through — a taxidermy bird, a rusted icon, a jar with something floating in it. Mechanically your familiar."
                ],
                [
                    "The Sigil",
                    "Your patron's mark, left by Cult Sign, by a Cursed Gift, or by any Rite that places it — always the same mark, and a creature carries only one of yours at a time."
                ],
                [
                    "Rites",
                    "Focus spells granted directly by your patron, paid for with Zeal."
                ],
                [
                    "Zeal",
                    "Your devotion, spent to cast Rites. A pool that refills on rest, like any focus points — except it's not really yours. It's on loan."
                ],
                [
                    "Revelations",
                    "Spells your patron teaches you directly at 1st, 5th, and 13th level, outside your normal known-spell progression."
                ],
                [
                    "Zealotry",
                    "Spending devotion past what your Zeal pool allows, for a bigger effect right now. Risks Backlash."
                ],
                [
                    "Backlash",
                    "What happens when the god notices you overspent. Roll on the Backlash Table (§4) — petty gods don't punish like wrathful ones. They punish like petty ones."
                ]
            ],
