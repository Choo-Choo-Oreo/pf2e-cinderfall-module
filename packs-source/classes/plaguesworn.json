    "flags": {
        "cinderfall": {
            "tagline": "The Choir doesn't need you to cure the sick. It needs you to decide who joins it.",
            "role": "Death-Singer / Thrall-Handler",
            "pillar": "Faith — the Soul Economy",
            "hpFormula": "6 + Con / level",
            "keyAbilityText": "Intelligence",
            "spellcastingText": "Occult, prepared (Intelligence)",
            "spellcastingTradition": "Occult",
            "spellcastingPreparation": "prepared",
            "terms": [
                [
                    "The Choir",
                    "Your patron — the Gaunt Choir, formed from a quarantine camp's unburied dead. Usable setting-wide as a petty-god patron via feat chain (see the Fleshmancer dossier §6), but a Plaguesworn is the one class whose entire chassis is built around hearing it directly, rather than borrowing its favor through a handful of feats."
                ],
                [
                    "Miasma",
                    "Your focus pool — Verse spells (§2) are Focus spells drawn from it. It doesn't refill on a clean rest: you Refocus only near sickness, death, or decay — a corpse, a sickbed, a Choir-touched site, or one of your own Afflicted — and it burns down when spent on Verses or raising the Afflicted."
                ],
                [
                    "Verse Spells",
                    "Your chosen Verse (§2) grants three Focus spells, fixed at half your level (minimum 1st) and heightening automatically as you level — they can't fall behind. Your separate prepared occult spell list (proficiency below; full list in What You Learned) is where the rest of your casting lives."
                ],
                [
                    "The Afflicted",
                    "Your thralls: the recently plague-dead, raised on borrowed time, humming fragments of the fever hymn as they move. Replaces the base class's undead minions."
                ],
                [
                    "Diagnosis",
                    "A signature action — read the true cause of a wound, curse, or sickness in a creature before you decide what to do about it. Feeds several Verse features."
                ],
                [
                    "The Choir's Toll",
                    "What happens when you draw more Miasma than you can safely carry. Roll on the Toll Table (§3) — the Choir doesn't punish. It just collects early."
                ]
            ],
