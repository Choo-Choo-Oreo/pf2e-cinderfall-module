        "cinderfall": {
            "tagline": "The gates are locked. You're one of the very few people left who still stand at them and knock.",
            "role": "Faith-Bearer — slow, then enormous",
            "pillar": "Faith — the true, not the petty",
            "hpFormula": "8 + Con / level",
            "keyAbilityText": "Wisdom",
            "spellcastingText": "Divine, prepared (Wisdom)",
            "spellcastingTradition": "Divine",
            "spellcastingPreparation": "prepared",
            "terms": [
                [
                    "The Silence",
                    "The condition of the world since God withdrew. Explains why a Vigil's ordinary turn does so little — it operates entirely inside it."
                ],
                [
                    "Presence",
                    "Your passive, always-on aura. Small, constant, never flashy. This is what a Vigil actually does most sessions."
                ],
                [
                    "Liturgy",
                    "Your day-to-day divine spellcasting — prepared cantrips and spells (full list in <em>What You Learned</em>), cast with Wisdom against your spell DC. It advances on the standard full-caster track (expert 5th, master 11th, legendary 17th). Separate from, and far smaller than, a Miracle: the small hours of keeping faith between the rare times it answers."
                ],
                [
                    "Grace / Cinders",
                    "The resource you slowly accumulate — Grace for the Unanswered, Cinders for the Choir of Ash. Gained rarely, through qualifying acts, not spent freely."
                ],
                [
                    "A Miracle / An Unmaking",
                    "The rare, huge, reality-touching act your accumulated Grace or Cinders finally buys. Three tiers: Lesser, Greater, Great (§4)."
                ],
                [
                    "Testament",
                    "The lasting mark a Miracle or Unmaking leaves on the world — remembered, named, changing how people treat you afterward."
                ]
            ],
