  "flags": {
    "item-piles": {
      "data": {
        "enabled": true,
        "type": "merchant",
        "distance": 5,
        "description": "Bio-augmentation. Marks only. No rate posted, and none coming.",
        "infiniteQuantity": true,
        "onlyAcceptBasePrice": false,
        "keepZeroQuantity": true,
        "displayQuantity": "no"
      },
      "version": "3.3.4"
    },
    "cinderfall": {
      "role": "merchant",
      "currency": "Mark",
      "note": "Item Piles merchant, shipped pre-configured. The three flags that are load-bearing and fail SILENTLY if wrong: actor onlyAcceptBasePrice=false (true makes a sell-back fall through to the item's normal cost, which is disabled here, so he would offer nothing for everything); item purchaseOptionsAsSellOption=true (gates whether the item's own price list is offered when the merchant is the buyer); and price fixed=false (fixed=true pins the modifier to 1, so buyback would pay the full asking price). A price entry also needs secondary=true or getItemFlagPriceData multiplies the mark by an absent exchangeRate and renders nothing.",
      "sellPriceModifier": "default (0.5) -- he buys back at half",
      "removedOnExport": [
        "flags.item-piles.data.tablesForPopulate pointed at a world RollTable (RollTable.i6Byvno5eg4V2C6D). A compendium actor cannot resolve a world uuid, so restock-from-table is configured per world, not shipped."
      ]
    }
