{
    "name": "Effect: Unnerving Presence",
    "type": "effect",
    "img": "icons/svg/mystery-man.svg",
    "system": {
        "description": {
            "value": "<p><em>Applied by <strong>Unnerving Presence</strong> to the character who used it.</em></p>\n<hr />\n<p>You display your patron's sigil openly. For the duration you gain a +2 circumstance bonus to Intimidation checks against anyone who knows what the sigil means, and a -2 circumstance penalty to Diplomacy checks against anyone who knows what the sigil means and disapproves. The GM decides who recognises it. You may end this effect by covering the sigil, which takes 1 action. When you Demoralize, you may use your class DC's key ability modifier in place of Charisma, and you never take the language penalty — the sigil does not need translating.</p>"
        },
        "duration": {
            "expiry": "turn-start",
            "sustained": false,
            "unit": "hours",
            "value": 1
        },
