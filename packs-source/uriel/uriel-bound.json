        {
            "_id": "iTQmlxm5lnmUgCcN",
            "img": "systems/pf2e/icons/actions/TwoActions.webp",
            "name": "The Word",
            "sort": 1200000,
            "system": {
                "actionType": {
                    "value": "action"
                },
                "actions": {
                    "value": 2
                },
                "category": "offensive",
                "description": {
                    "value": "<p>(auditory, concentrate, divine, incapacitation, mental); <b>Requirements</b> at least three Bonds destroyed. <b>Effect</b> Uriel says one word of what he was sent in 2100 to say. Each creature in a 60-ft cone attempts a <b>DC 45 Will</b> save — this is the message, not an attack. <b>Crit Success</b> unaffected. <b>Success</b> stunned 1. <b>Failure</b> stunned 3, and can't take hostile actions against Uriel for 1 minute (you understood him). <b>Crit Failure</b> as failure, and <em>overwhelmed</em> — GM and player decide together what the character does now that they completely agree the old world should have ended. Not domination; comprehension. He doesn't use it twice in one fight.</p>"
                },
                "publication": {
                    "license": "ORC",
                    "remaster": true,
                    "title": "Cinderfall"
                },
                "rules": [],
