        {
            "_id": "QMvc7zfLOzbWMxLt",
            "img": "systems/pf2e/icons/actions/Passive.webp",
            "name": "Not Your Enemy Yet",
            "sort": 1300000,
            "system": {
                "actionType": {
                    "value": "passive"
                },
                "actions": {
                    "value": null
                },
                "category": "interaction",
                "description": {
                    "value": "<p>Uriel takes no hostile action against a creature that hasn't attacked him, damaged a Bond, or channelled drawn angelic power in his sight. He'll speak — telepathically, plainly, unhurried — with anyone who reaches the Seat without a weapon raised. Negotiate / redeem / replace all run in that conversation; no skill DC wins it, only the keys the campaign planted.</p>"
                },
                "publication": {
